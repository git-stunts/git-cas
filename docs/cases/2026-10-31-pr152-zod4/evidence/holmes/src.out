     1	import * as z from "./v4/classic/external.js";
     2	export * from "./v4/classic/external.js";
     3	// Aliasing the binding, instead of `export default z`, keeps the default export a
     4	// re-export of `z` rather than a fresh namespace value. Rollup and Webpack can then
     5	// shake `import z from "zod"` as they already shake `import { z } from "zod"` — without
     6	// this they pull in every locale. See #6050.
     7	export { z, z as default };
